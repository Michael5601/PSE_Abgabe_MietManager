/* MietManager – einheitliches, schlankes Erscheinungsbild */

* {
    font-family: "Segoe UI";
    font-size: 10pt;
}

QWidget {
    background-color: #F5F6F8;
    color: #1F2430;
}

QMainWindow {
    background-color: #F5F6F8;
}

/* --- Tabs --- */

QTabWidget {
    background-color: #2E5AAC;
    border-radius: 8px;
}

QTabWidget::pane {
    border: 1px solid #D8DCE1;
    border-top: none;
    border-radius: 0 0 8px 8px;
    background-color: #FFFFFF;
    top: -1px;
}

QTabBar::tab {
    background-color: #2E5AAC;
    color: #FFFFFF;
    padding: 10px 20px;
    margin: 6px 2px 0 6px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #2E5AAC;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: #3E6BBE;
    color: #FFFFFF;
}

/* --- Buttons --- */

QPushButton {
    background-color: #FFFFFF;
    color: #1F2430;
    border: 1px solid #D8DCE1;
    border-radius: 6px;
    padding: 7px 16px;
    cursor: pointing-hand;
}

QPushButton:hover {
    border-color: #2E5AAC;
    color: #2E5AAC;
}

QPushButton:pressed {
    background-color: #EAEFF8;
}

QPushButton:disabled {
    color: #A7AEB8;
    border-color: #E4E7EB;
}

QPushButton#primaryButton {
    background-color: #2E5AAC;
    color: #FFFFFF;
    border: 1px solid #2E5AAC;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #274C8F;
    color: #FFFFFF;
}

QPushButton#primaryButton:disabled {
    background-color: #A9BBDD;
    border-color: #A9BBDD;
    color: #F0F2F6;
}

QPushButton#dangerButton:hover {
    border-color: #C0392B;
    color: #C0392B;
}

/* --- Eingabefelder --- */

QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D8DCE1;
    border-radius: 5px;
    padding: 4px 8px;
    selection-background-color: #2E5AAC;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #2E5AAC;
}

/* Deutlich sichtbarer "gesperrt"-Zustand, z.B. für das Ende-Datum bei unbefristeten Mietverträgen:
   ohne diese Regel sieht ein deaktiviertes Feld optisch kaum anders aus als ein normales. */
QLineEdit:disabled, QComboBox:disabled, QDateEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #EDEFF2;
    border: 1px solid #E4E7EB;
    color: #A7AEB8;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

/* --- Tabellen / Baumansicht --- */

QTableWidget, QTreeWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F7F9FB;
    gridline-color: #E4E7EB;
    border: 1px solid #D8DCE1;
    border-radius: 6px;
}

QHeaderView::section {
    background-color: #2E3B4E;
    color: #FFFFFF;
    padding: 6px;
    border: none;
    font-weight: 600;
}

QTableCornerButton::section {
    background-color: #2E3B4E;
    border: none;
}

QTableWidget::item, QTreeWidget::item {
    padding: 3px;
}

QTableWidget::item:selected, QTreeWidget::item:selected {
    background-color: #BFD7F5;
    color: #1F2430;
}

QTableWidget::item:selected:!active, QTreeWidget::item:selected:!active {
    background-color: #D6E4F8;
    color: #1F2430;
}

/* --- Dialoge --- */

QDialog {
    background-color: #FFFFFF;
}

QLabel {
    background: transparent;
}

/* --- Kopfzeile / Avatar --- */

QLabel#appTitle {
    font-size: 15pt;
    font-weight: 700;
    color: #1F2430;
}

QPushButton#avatarButton {
    background-color: #2E5AAC;
    color: #FFFFFF;
    border: none;
    border-radius: 20px;
    font-weight: 700;
    font-size: 11pt;
    padding: 0;
}

QPushButton#avatarButton:hover {
    background-color: #274C8F;
}

QWidget#profilPopupWindow {
    background-color: #FFFFFF;
    border: 1px solid #D8DCE1;
    border-radius: 12px;
}

/* --- Statistik-Karten (Dashboard) --- */

QWidget#card {
    background-color: #FFFFFF;
    border: 1px solid #D8DCE1;
    border-radius: 12px;
}

QFrame#statCard {
    background-color: #FFFFFF;
    border: 1px solid #D8DCE1;
    border-top: 3px solid #2E5AAC;
    border-radius: 12px;
    padding: 18px;
}

QLabel#statValue {
    font-size: 26pt;
    font-weight: 700;
    color: #1F2430;
}

QLabel#statTitle {
    font-size: 9pt;
    color: #5B6472;
}

/* --- Scrollbars --- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #C6CCD4;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #A7AEB8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #C6CCD4;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
