# Byte-compiled / optimized files
__pycache__/
*.py[codz]
*$py.class

# Distribution / packaging
build/
*.egg-info/

# dist/ enthält PyInstaller-Build-Artefakte; die fertige exe wird für die Abgabe
# bewusst mit ins Repo aufgenommen, alles andere darin bleibt ignoriert.
dist/*
!dist/MietManager.exe

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/

# Environments
.env
.venv

# VS Code
tempCodeRunnerFile.py

/docs
